# ── Private service boundary ──────────────────────────────────────────────────
# Generate strong random values; never commit real credentials.
# Read-only service token used by Pi / Command Center server-to-server calls.
BRAIN_SERVICE_TOKEN=replace-with-random-read-token
# Separate write token for agents that are explicitly allowed to mutate private state.
BRAIN_WRITE_TOKEN=replace-with-different-random-write-token
# Owner bootstrap token; exchanged once for an HttpOnly signed browser session.
BRAIN_OWNER_TOKEN=replace-with-random-owner-token
# HMAC key used only to sign owner sessions.
BRAIN_SESSION_SECRET=replace-with-random-session-secret

# ── Vault source ─────────────────────────────────────────────────────────────
# "github" = reads from a GitHub repo via API (default)
# "tailscale" = reads from local files via Tailscale proxy
VAULT_SOURCE=github

# ── GitHub vault source ───────────────────────────────────────────────────────
# Prefer a private GitHub repo that holds only the canonical vault.
VAULT_GITHUB_OWNER=executiveusa
VAULT_GITHUB_REPO=mental-models
VAULT_GITHUB_BRANCH=main
# Fine-grained token: Contents = Read-only on the vault repo.
VAULT_GITHUB_TOKEN=replace-with-read-only-token

# ── Tailscale vault source ───────────────────────────────────────────────────
# Only needed if VAULT_SOURCE=tailscale.
TAILSCALE_PROXY_HOST=your-machine-name.ts.net:3001
TAILSCALE_PROXY_SECRET=replace-with-random-proxy-secret

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Service role key — only needed for the indexer, never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-key
